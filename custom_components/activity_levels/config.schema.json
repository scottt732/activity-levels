          "additionalProperties": false,
          "default": {}
        },
        "scanner_areas": {
          "type": "object",
          "properties": {},
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "A group id: lowercase letters, digits and underscores, starting with a letter."
          },
          "default": {}
        }
      },
      "additionalProperties": false,
      "default": {},
      "description": "Room-level presence from Bermuda device trackers. Absent, or `enabled: false`, turns the whole feature off."
    }
