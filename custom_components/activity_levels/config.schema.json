              {
                "type": "string"
              }
            ],
            "default": null
          },
          "attack": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "string",
                "pattern": "^\\s*(\\d+(\\.\\d+)?\\s*[smhdSMHD]|\\d+:\\d{2}(:\\d{2}(\\.\\d+)?)?)\\s*$"
              }
            ],
            "description": "A duration: a number of seconds, '30s'/'5m'/'2h'/'1d', or 'HH:MM[:SS[.f]]'.",
            "default": 0.0
          },
          "decay": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "string",
                "pattern": "^\\s*(\\d+(\\.\\d+)?\\s*[smhdSMHD]|\\d+:\\d{2}(:\\d{2}(\\.\\d+)?)?)\\s*$"
              }
            ],
            "description": "A duration: a number of seconds, '30s'/'5m'/'2h'/'1d', or 'HH:MM[:SS[.f]]'.",
            "default": 0.0
          },
          "sustain": {
            "type": "number",
            "minimum": 0.0,
            "default": 1.0
          },
          "release": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "string",
                "pattern": "^\\s*(\\d+(\\.\\d+)?\\s*[smhdSMHD]|\\d+:\\d{2}(:\\d{2}(\\.\\d+)?)?)\\s*$"
              }
            ],
            "description": "A duration: a number of seconds, '30s'/'5m'/'2h'/'1d', or 'HH:MM[:SS[.f]]'.",
            "default": 1800.0
          },
          "impulse": {
            "type": "boolean",
            "default": false
          },
          "retrigger": {
