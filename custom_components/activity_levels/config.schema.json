          "default": []
        },
        "envelope": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$",
              "description": "A group id: lowercase letters, digits and underscores, starting with a letter."
            }
          ],
          "default": null
        },
        "threshold": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "default": 0.6
        },
        "stay": {
          "type": "number",
          "exclusiveMinimum": 0.0,
