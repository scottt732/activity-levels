                  "always",
                  "after_attack",
                  "after_decay",
                  "release",
                  "idle"
                ]
              }
            ],
            "default": null
          },
          "stack": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "boolean"
              }
            ],
            "default": null
          },
          "unavailable": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "enum": [
                  "hold",
                  "note_off"
                ]
              }
            ],
            "default": null
          },
          "debounce": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "string",
                    "pattern": "^\\s*(\\d+(\\.\\d+)?\\s*[smhdSMHD]|\\d+:\\d{2}(:\\d{2}(\\.\\d+)?)?)\\s*$"
                  }
                ],
                "description": "A duration: a number of seconds, '30s'/'5m'/'2h'/'1d', or 'HH:MM[:SS[.f]]'."
              }
            ],
            "default": null
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "default": [],
      "description": "Named ADSR presets. A stimulus names one by id and may override any of its fields inline; `defaults.envelope` names the one used when a stimulus names none."
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      },
      "default": [],
      "description": "The tree of places. Every root group is a property; a property holds structures and outdoor areas, a structure holds floors, a floor holds areas, and an outdoor area holds outdoor areas."
    },
