{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Activity Levels configuration",
  "description": "The options document for the Activity Levels Home Assistant integration. Paste this schema's URL into your editor with '# yaml-language-server: $schema=/activity_levels_panel/config.schema.json'.",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1
      ],
      "description": "Document version. Only 1 exists."
    },
    "defaults": {
      "type": "object",
      "properties": {
        "envelope": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "A group id: lowercase letters, digits and underscores, starting with a letter.",
          "default": "default"
        },
        "max_value": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "default": 5.0
        },
        "precision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "default": 1
        },
        "unavailable": {
          "enum": [
            "hold",
            "note_off"
          ],
          "default": "hold"
        },
        "retrigger": {
          "enum": [
            "always",
            "after_attack",
            "after_decay",
            "release",
            "idle"
          ],
          "default": "always"
        },
        "stack": {
          "type": "boolean",
          "default": true
        },
        "debounce": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^\\s*(\\d+(\\.\\d+)?\\s*[smhdSMHD]|\\d+:\\d{2}(:\\d{2}(\\.\\d+)?)?)\\s*$"
            }
          ],
          "description": "A duration: a number of seconds, '30s'/'5m'/'2h'/'1d', or 'HH:MM[:SS[.f]]'.",
          "default": 0.0
        },
        "safety_refresh": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^\\s*(\\d+(\\.\\d+)?\\s*[smhdSMHD]|\\d+:\\d{2}(:\\d{2}(\\.\\d+)?)?)\\s*$"
            }
          ],
          "description": "A duration: a number of seconds, '30s'/'5m'/'2h'/'1d', or 'HH:MM[:SS[.f]]'. Between 5.0 and 3600.0 seconds.",
          "default": 60.0
        },
        "min_wake_interval": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^\\s*(\\d+(\\.\\d+)?\\s*[smhdSMHD]|\\d+:\\d{2}(:\\d{2}(\\.\\d+)?)?)\\s*$"
            }
          ],
          "description": "A duration: a number of seconds, '30s'/'5m'/'2h'/'1d', or 'HH:MM[:SS[.f]]'. Between 0.1 and 60.0 seconds.",
          "default": 1.0
        },
        "patterns": {
          "type": "object",
          "properties": {
            "rebuild_time": {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
              "description": "A time of day, 'HH:MM' on a 24-hour clock.",
              "default": "03:00"
            },
            "history_days": {
              "type": "integer",
              "minimum": 30,
              "maximum": 730,
              "default": 180
            },
            "min_days": {
              "type": "integer",
              "minimum": 3,
              "maximum": 90,
              "default": 14
            },
            "calendars": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$",
                    "description": "A group id: lowercase letters, digits and underscores, starting with a letter."
                  },
                  "entity": {
                    "type": "string",
                    "pattern": "^calendar\\.[a-z0-9_]+$"
                  }
                },
                "required": [
                  "id",
                  "entity"
                ],
                "additionalProperties": false
              },
              "default": []
            },
            "day_type_precedence": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                }
              ],
              "default": null
            },
            "workday_entity": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$"
                }
              ],
              "default": null
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "simulation": {
          "type": "object",
          "properties": {
            "away_entity": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$"
                }
              ],
              "default": null
            },
            "quiet_hours": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              ],
              "description": "A [start, end] pair of 'HH:MM' times, or null to disable.",
              "default": [
                "01:00",
                "05:30"
              ]
            }
          },
          "additionalProperties": false,
          "default": {}
        }
      },
      "additionalProperties": false,
      "default": {},
      "description": "Settings every group inherits unless it says otherwise, plus the pattern-learning and presence-simulation options, which are configured only here."
    },
    "envelopes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "A group id: lowercase letters, digits and underscores, starting with a letter."
